# Copy to .env and fill in. NEVER commit .env (it contains a private key).

# RPC endpoint for Sepolia (defaults to a public node if omitted).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Private key of the deploying account (with Sepolia test ETH for gas).
# Use a throwaway/testing account — never a key holding real funds.
PRIVATE_KEY=

# Etherscan API key, for automatic source verification after deploy.
# Get one free at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
