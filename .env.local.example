# Get a free project ID at https://cloud.walletconnect.com
# This is required for WalletConnect to work. Without it, the WalletConnect
# option will be hidden / non-functional, but injected (MetaMask) still works.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Alchemy API key — enables automatic token DISCOVERY (lists every token a
# wallet holds on each network) in the Portfolio & Send features. Get a free
# key at https://dashboard.alchemy.com. Without it, the app falls back to the
# curated per-network token lists, so it still works.
NEXT_PUBLIC_ALCHEMY_API_KEY=

# Optional: override the RPC endpoints used to read on-chain data (balances).
# Defaults to reliable publicnode endpoints. For production, use a dedicated
# provider like Alchemy or Infura for higher rate limits.
# NEXT_PUBLIC_MAINNET_RPC_URL=
# NEXT_PUBLIC_BASE_RPC_URL=
# NEXT_PUBLIC_POLYGON_RPC_URL=
# NEXT_PUBLIC_ARBITRUM_RPC_URL=
# NEXT_PUBLIC_OPTIMISM_RPC_URL=
# NEXT_PUBLIC_BSC_RPC_URL=
# NEXT_PUBLIC_SEPOLIA_RPC_URL=
